        },
        "output_tokens": 329,
        "output_tokens_details": {
          "reasoning_tokens": 274
        },
        "total_tokens": 6089,
        "x_details": [
          {
            "input_tokens": 5760,
            "output_tokens": 329,
            "output_tokens_details": {
              "reasoning_tokens": 274
            },
            "prompt_tokens_details": {
              "cached_tokens": 4096
