            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 678,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S01-U03",
      "role": "client",
      "text": "其实不光是路上，我后来想想，看到晚班那一下我还松了口气，想着能晚点回家。但马上又觉得自己很没良心，她又不是故意要疼的。",
      "request_sha256": "8058e39d7a4f1e82d02c49e4c01f5a57cbf2d316e0c221a250f31035c0e1a94f",
      "usage": {
        "input_tokens": 718,
