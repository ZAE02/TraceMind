            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 3119,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S03-U05",
      "role": "client",
      "text": "其实停那一下，不是失望，是突然想起他以前帮我看过画，还夸过我笔触有灵气。现在留着也只会提醒我，我和那个“有灵气”的人越走越远了。删完确实松了口气，可马上又觉得自己挺幼稚的，三十岁还做这种清空列表的事。",
      "request_sha256": "e17e3a71a77993545e906b05cdaa43002eebed1739213893ce631c233b916509",
      "usage": {
        "input_tokens": 3744,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 552,
        "output_tokens_details": {
          "reasoning_tokens": 483
        },
        "total_tokens": 4296,
        "x_details": [
          {
            "input_tokens": 3744,
            "output_tokens": 552,
            "output_tokens_details": {
              "reasoning_tokens": 483
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 4296,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S03-U06",
      "role": "counselor",
      "text": "你删掉学长时停的那一下，好像不只是对这个人，而是对那个被他夸过“有灵气”的自己——留下他就会一直提醒你离那个自己越来越远。删完松了口气，又觉得自己三十岁还做清空列表这种事很幼稚，好像连给自己减少一点刺痛的方式，你都要先批评自己一顿。",
      "request_sha256": "0054eef76f918cdaf67aff004da1a349e84eb4ce44870bd5de50288c2d70a9cb",
      "usage": {
        "input_tokens": 3110,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 690,
        "output_tokens_details": {
          "reasoning_tokens": 620
        },
        "total_tokens": 3800,
