            "output_tokens": 291,
            "output_tokens_details": {
              "reasoning_tokens": 214
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 3045,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S03-U03",
      "role": "client",
      "text": "对，就是那种被当成落后分子的感觉。其实我连一个小时都没坐满，提前走了，回来路上删了几个刚加的人。删到那个以前挺尊敬的学长时，我停了一下，还是删了。",
      "request_sha256": "e4517c2d4550fc7f83b91430569261fb1cf2a21d0ae65e4e8df5a0c8a4560754",
      "usage": {
        "input_tokens": 3579,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 816,
        "output_tokens_details": {
          "reasoning_tokens": 769
        },
        "total_tokens": 4395,
        "x_details": [
          {
            "input_tokens": 3579,
            "output_tokens": 816,
            "output_tokens_details": {
              "reasoning_tokens": 769
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 4395,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S03-U04",
      "role": "counselor",
      "text": "删到学长时停了一下，说明这段关系对你来说并不完全是“加错了”或“不重要”的。你提前离场又删人，像是想从那种被当成落后分子的难受里赶快逃出来，可删掉一个曾经尊敬的人，也许还带着一点别的什么——比如失望，或者不想让对方看到自己现在的样子？",
      "request_sha256": "56dfbfa837ff7ddcf10cd9db60b835a4800cbea396b81c10b19c1ac80b135d7f",
      "usage": {
        "input_tokens": 2923,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 196,
        "output_tokens_details": {
          "reasoning_tokens": 123
        },
        "total_tokens": 3119,
        "x_details": [
          {
            "input_tokens": 2923,
            "output_tokens": 196,
            "output_tokens_details": {
