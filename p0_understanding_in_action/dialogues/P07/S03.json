            "total_tokens": 3740,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S03-U11",
      "role": "client",
      "text": "其实那个邮件也不是多重，就是每次划过去，都觉得它在替别人问我：你还能不能画。我甚至已经想好怎么回复周姐了，就说最近档期排得太满，接不了。可这个借口说出来，自己都觉得虚，像往墙上贴一层湿墙纸。",
      "request_sha256": "5863546e9ae8d17efd1a658bc11648e6052f0f94fe76ee0153b979abc115b4e4",
      "usage": {
        "input_tokens": 4266,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 373,
        "output_tokens_details": {
          "reasoning_tokens": 310
