              "cached_tokens": 7168
            },
            "total_tokens": 8889,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S06-U15",
      "role": "client",
      "text": "其实我今晚大概也不会再碰那个草稿了，手机倒扣在桌上，好像那样就能把陈曦的消息也一起扣住。有时候觉得挺对不住她的，她也没做错什么，可能只是我还没想好怎么接住别人的好意。先这样吧，我再不走，糯糯该把猫粮袋子当敌人了。",
      "request_sha256": "844d989d984adca36f03bf181c78306b309285840e345db9417d4301ced6bd7c",
      "usage": {
