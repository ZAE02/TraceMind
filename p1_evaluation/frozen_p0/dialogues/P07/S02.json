        },
        "output_tokens": 255,
        "output_tokens_details": {
          "reasoning_tokens": 199
        },
        "total_tokens": 2707,
        "x_details": [
          {
            "input_tokens": 2452,
            "output_tokens": 255,
            "output_tokens_details": {
              "reasoning_tokens": 199
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
