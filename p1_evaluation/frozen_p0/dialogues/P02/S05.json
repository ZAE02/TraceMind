            "total_tokens": 5965,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S05-U05",
      "role": "client",
      "text": "其实我也说不上为什么，就总觉得靠下去太像真的在休息了，万一那一下睡着了更麻烦。那个长椅其实挺硬的，我坐得板正，像在等叫号一样。回家洗手的时候水冲得挺久，其实我是想多站一会儿，可又怕我妈在饭桌边催。",
      "request_sha256": "7230b01c3dbb799197dee64f22e7282915bb41850cf116a51f2bf3a7c83ea522",
      "usage": {
        "input_tokens": 6175,
        "input_tokens_details": {
          "cached_tokens": 5120
        },
        "output_tokens": 399,
        "output_tokens_details": {
          "reasoning_tokens": 328
        },
        "total_tokens": 6574,
        "x_details": [
          {
            "input_tokens": 6175,
            "output_tokens": 399,
            "output_tokens_details": {
              "reasoning_tokens": 328
            },
            "prompt_tokens_details": {
              "cached_tokens": 5120
