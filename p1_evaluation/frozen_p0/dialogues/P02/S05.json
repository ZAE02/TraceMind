            "prompt_tokens_details": {
              "cached_tokens": 5120
            },
            "total_tokens": 5945,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S05-U07",
      "role": "client",
      "text": "其实我后来有想，那一小时就像从谁那里偷来的，回家洗手的时候，水流得越久越觉得不是自己的时间。我妈说“怎么去那么久”，我到现在也没想好，她要是再问，我是不是还得继续编下去。",
      "request_sha256": "4829c26029a7a24b5b3a304667eb756205e73ccac4f87a335bdd0312be014c1c",
      "usage": {
        "input_tokens": 6371,
        "input_tokens_details": {
          "cached_tokens": 5120
        },
        "output_tokens": 286,
        "output_tokens_details": {
          "reasoning_tokens": 230
        },
        "total_tokens": 6657,
        "x_details": [
          {
            "input_tokens": 6371,
            "output_tokens": 286,
            "output_tokens_details": {
              "reasoning_tokens": 230
            },
            "prompt_tokens_details": {
              "cached_tokens": 5120
            },
            "total_tokens": 6657,
            "x_billing_type": "response_api"
