            "total_tokens": 6574,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S05-U06",
      "role": "counselor",
      "text": "“靠下去太像真的在休息了”，这句话里好像休息对你来说不只是放松，还带着一点危险——怕自己真的睡着了、怕被打断、怕太像真的停下。所以你在长椅上坐得那么板正，像等叫号一样，连洗手时多冲一会儿水，都只能算是一小段偷来的、暂时不用回到饭桌的时间。",
      "request_sha256": "899ad562088cd5ec06856807b14fc66ea9e7b48ef65c4f41553cdc97c8eceedb",
      "usage": {
        "input_tokens": 5659,
        "input_tokens_details": {
          "cached_tokens": 5120
        },
        "output_tokens": 286,
        "output_tokens_details": {
          "reasoning_tokens": 206
        },
        "total_tokens": 5945,
        "x_details": [
          {
