  "utterances": [
    {
      "id": "P04-S01-U01",
      "role": "client",
      "text": "最近店里的排班像被谁打翻的酱料台，怎么都抹不匀。新菜单上市那天两个厨师临时不来，我顶到凌晨，回家发现我妈还在等我，桌上放着凉透的降压药。",
      "request_sha256": "16c9b77341088a6852ae7bb8c5a3dce2242466f2827e9f68211698c149fe3e28",
      "usage": {
        "input_tokens": 561,
        "input_tokens_details": {
          "cached_tokens": 0
