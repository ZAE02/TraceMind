              "cached_tokens": 0
            },
            "total_tokens": 3803,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P04-S03-U02",
      "role": "counselor",
      "text": "你砸出去的那一下，好像不只是对那两个服务员，更像是那句“请个护工不就好了”终于从你手里炸出来了。之后搓手指那半小时，可能不只是想把抖压回去，也是在怕自己怎么就没能像平常那样扛住。",
      "request_sha256": "88d8848834d6cdc0a895784375b779d95cbb3cceaed8c96ea8e2cfc8c7126bd8",
      "usage": {
        "input_tokens": 2880,
        "input_tokens_details": {
          "cached_tokens": 0
        },
        "output_tokens": 428,
        "output_tokens_details": {
          "reasoning_tokens": 373
        },
        "total_tokens": 3308,
        "x_details": [
          {
            "input_tokens": 2880,
            "output_tokens": 428,
            "output_tokens_details": {
              "reasoning_tokens": 373
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 3308,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P04-S03-U03",
      "role": "client",
      "text": "我搓了半小时，不是怕摔杯子，是怕被人看见我手在抖。后来出去，服务生都不敢看我。我听见有人小声说“周经理最近脾气不对”，那话像油星子溅进袖口里，贴着皮肤凉不下来。",
      "request_sha256": "1f36de976f4b3a05d0aad83488b7dd0bf6c4b4e186670efde613ccb2c800e0ae",
      "usage": {
        "input_tokens": 3474,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 264,
        "output_tokens_details": {
          "reasoning_tokens": 207
        },
        "total_tokens": 3738,
        "x_details": [
          {
            "input_tokens": 3474,
            "output_tokens": 264,
            "output_tokens_details": {
              "reasoning_tokens": 207
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 3738,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P04-S03-U04",
      "role": "counselor",
      "text": "“脾气不对”那四个字，好像不只说你在店里发火，更像在说：那个一直能扛的周经理，被人看见裂缝了。这比摔杯子本身更让你发凉。",
      "request_sha256": "a54f5fb92ce15f9f2db1d29184a1d779fab987b4f62f25ee1f965d26453586f7",
      "usage": {
        "input_tokens": 3037,
        "input_tokens_details": {
