            "output_tokens": 325,
            "output_tokens_details": {
              "reasoning_tokens": 250
            },
            "prompt_tokens_details": {
              "cached_tokens": 8192
            },
            "total_tokens": 8978,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S07-U13",
      "role": "client",
      "text": "我回去再找孙主管说说，总不能就这么等着。赵岩那天讲的我也记下了，有些材料说不定还有别的办法补。至于当时为什么张不开嘴，我也说不上来，等忙完这阵再想吧。",
      "request_sha256": "3fed4671b79ef43117a87124a91b85501c0d6710dcfab7af4039ad0481c780e1",
      "usage": {
        "input_tokens": 9797,
        "input_tokens_details": {
          "cached_tokens": 8192
        },
        "output_tokens": 419,
        "output_tokens_details": {
          "reasoning_tokens": 369
        },
        "total_tokens": 10216,
        "x_details": [
