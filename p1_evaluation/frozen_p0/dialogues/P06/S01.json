              "cached_tokens": 0
            },
            "total_tokens": 298,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S01-U03",
      "role": "client",
      "text": "其实吧，我也不知道，就是突然一股火窜上来。那孩子折纸飞机的时候我脑子里全是早上厨房的烟味，还有电话里那句“下次注意”。我撕的时候手都在抖，就觉得自己连个小孩都管不住，更别说家里那一摊了。",
      "request_sha256": "d50fd6f5208af36ede55d6b696bbce24a2865dce6aa8f158f2255ee269898487",
      "usage": {
        "input_tokens": 720,
        "input_tokens_details": {
          "cached_tokens": 0
        },
        "output_tokens": 212,
        "output_tokens_details": {
          "reasoning_tokens": 153
        },
        "total_tokens": 932,
        "x_details": [
          {
            "input_tokens": 720,
            "output_tokens": 212,
            "output_tokens_details": {
              "reasoning_tokens": 153
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 932,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S01-U04",
      "role": "counselor",
      "text": "那股火好像把早上厨房的烟味和电话里那句“下次注意”都卷了进来，纸飞机成了一个引爆点。你说自己像控制不住的疯子，我听到更多的是你对自己有很多失望和自责。",
      "request_sha256": "3d34cb35550d551d9ebb87c343efa4b77bcb1576f69ca0e9789f8ace5f4febc1",
      "usage": {
        "input_tokens": 347,
