            "output_tokens": 464,
            "output_tokens_details": {
              "reasoning_tokens": 396
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 3580,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U02",
      "role": "counselor",
      "text": "听起来这周你被好几件事同时拽着：女儿的发烧、没写完的教案、妈妈拿错了药。你差点在办公室哭出来，可好像连那个“差点”都被你压着，只剩一闭眼就转个不停。你现在坐在这里，周围这些事里最让你揪着放不下的是哪一件？",
      "request_sha256": "e8222fc6d85addd20cb973a83ed0ffd161c3c885c6c539f8eebb34ac4c5f90e6",
      "usage": {
        "input_tokens": 2611,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 327,
        "output_tokens_details": {
          "reasoning_tokens": 257
        },
        "total_tokens": 2938,
        "x_details": [
          {
            "input_tokens": 2611,
            "output_tokens": 327,
            "output_tokens_details": {
              "reasoning_tokens": 257
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 2938,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U03",
      "role": "client",
      "text": "其实吧，我也说不上哪一件最揪着，就像它们是一起压上来的。女儿喊妈妈的时候我人还在改教案，脑子却一下转到那瓶退烧药上，差点把旁边的水杯碰翻。我总觉得自己慢一步就会出大事，连去趟厕所都得盘算着时间。",
      "request_sha256": "9eb594f17e88067bfe79d0978b360f550ee85d834ee200bb5ea2cf98a29169d4",
      "usage": {
        "input_tokens": 3300,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 388,
        "output_tokens_details": {
          "reasoning_tokens": 319
        },
        "total_tokens": 3688,
        "x_details": [
          {
            "input_tokens": 3300,
            "output_tokens": 388,
            "output_tokens_details": {
              "reasoning_tokens": 319
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 3688,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U04",
      "role": "counselor",
      "text": "这些事不是一件一件来，而是一起压上来，所以你连在女儿喊妈妈的时候，脑子都还在教案和药瓶之间来回跳。你好像一直把自己放在“慢一步就会出大事”的警报里，连去厕所都要盘算时间，是因为你几乎不敢让自己松下来。",
      "request_sha256": "5ec92d807bf38d20c2a0f6d37453b6a0f62f1a000c6e869931a24d34e188c997",
      "usage": {
        "input_tokens": 2795,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 783,
        "output_tokens_details": {
          "reasoning_tokens": 718
        },
        "total_tokens": 3578,
        "x_details": [
          {
            "input_tokens": 2795,
            "output_tokens": 783,
            "output_tokens_details": {
              "reasoning_tokens": 718
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 3578,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U05",
      "role": "client",
      "text": "其实吧，我就是不敢松，怕一松下来又出那种事。我妈拿错药那晚，我坐在厨房地上盯着那两瓶药，脑子里全是我爸走之前的样子，然后就咬了自己一口，怕自己真喊出来。",
      "request_sha256": "ceaafb5726e1bee5d25730a28e9e055ba90a3981a792be620923fd45830f11f8",
      "usage": {
        "input_tokens": 3479,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 198,
        "output_tokens_details": {
          "reasoning_tokens": 145
        },
        "total_tokens": 3677,
        "x_details": [
          {
            "input_tokens": 3479,
            "output_tokens": 198,
            "output_tokens_details": {
              "reasoning_tokens": 145
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 3677,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U06",
      "role": "counselor",
      "text": "你咬自己那一下，像是在把快要冲出来的声音硬压回去。盯着那两瓶药时，脑子里浮起爸爸走之前的样子——那一瞬间的恐惧，好像不只在药上，也怕自己会像当时那样喊出来、或者完全撑不住。",
      "request_sha256": "610122e930310e0943bc36cbaa43917212e118c903deb89004adbaba0f577ac4",
      "usage": {
        "input_tokens": 2958,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 264,
        "output_tokens_details": {
          "reasoning_tokens": 206
        },
        "total_tokens": 3222,
        "x_details": [
          {
            "input_tokens": 2958,
            "output_tokens": 264,
            "output_tokens_details": {
              "reasoning_tokens": 206
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 3222,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U07",
      "role": "client",
      "text": "其实吧，我最怕的就是自己哪天会像我爸走的那晚一样，整个人突然就空了，只能靠咬自己留住一点知觉。你刚一说“喊出来”，我手臂上那个牙印好像又烫起来了。",
      "request_sha256": "13bcb92f01a6cb013fec3bcd845f05babe4bb42ec5dcb0a6ca5e700fea736e7c",
      "usage": {
        "input_tokens": 3635,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 474,
        "output_tokens_details": {
          "reasoning_tokens": 426
        },
        "total_tokens": 4109,
        "x_details": [
          {
            "input_tokens": 3635,
            "output_tokens": 474,
            "output_tokens_details": {
              "reasoning_tokens": 426
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
            },
            "total_tokens": 4109,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U08",
      "role": "counselor",
      "text": "那个牙印会“烫起来”，像是那个“怕自己空了”的感觉现在还在你身体里，并没有停在那个晚上。你说靠咬自己留住一点知觉——我在想，是不是在那一刻，你需要用痛来确认自己还在，还没有整个散掉。",
      "request_sha256": "6958b0a4fc1f396c1d9e64951994d3fa5896d1d082d77fcdd67e3112e410f896",
      "usage": {
        "input_tokens": 3109,
        "input_tokens_details": {
