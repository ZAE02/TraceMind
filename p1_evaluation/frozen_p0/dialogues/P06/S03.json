            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
            },
            "total_tokens": 3797,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U15",
      "role": "client",
      "text": "其实吧，我总觉得自己连羡慕别人的资格都没有，她们能那样活着是因为没被这些事缠住，而我要是也那么想，就像在怪自己的命。可我真的没有力气去怪谁，只能一遍遍告诉自己“这就是你的日子”。",
      "request_sha256": "ffa5d5df2bece57e5d3015045e806abec5eb797c0470e9c6e617dfe48417654a",
      "usage": {
        "input_tokens": 4273,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 239,
        "output_tokens_details": {
          "reasoning_tokens": 185
        },
        "total_tokens": 4512,
        "x_details": [
          {
            "input_tokens": 4273,
            "output_tokens": 239,
            "output_tokens_details": {
              "reasoning_tokens": 185
            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
            },
            "total_tokens": 4512,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U16",
      "role": "counselor",
      "text": "你把羡慕也当成了一种“没资格”的东西，好像往轻松那边看一眼，就是在否定自己现在这样活着；可那句“一遍遍告诉自己‘这就是你的日子’”，听起来像是把累和委屈都咽下去后，不许自己再问一句“那我呢”。今天先到这里吧，你愿意把这些说出来，已经很不容易。",
      "request_sha256": "20036438d535695b4558827980db6b52fa7b63b1496ec1b31646a4b1822d7371",
