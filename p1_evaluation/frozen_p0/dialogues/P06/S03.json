            "total_tokens": 4183,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U10",
      "role": "counselor",
      "text": "那种“被从头顶撕开”的感觉听起来很可怕，像整个人都要裂成几片，而你还能说出它，已经是在努力把自己兜住。你半夜先摸一摸手腕才敢动，好像也需要先确认自己还在、还连着，才敢继续面对这个身体。",
      "request_sha256": "7810c932344153fdcaa1e3aaa13d2775e94d4ef86e62a911eb39c85eb95bc121",
      "usage": {
        "input_tokens": 3259,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 279,
        "output_tokens_details": {
          "reasoning_tokens": 217
        },
        "total_tokens": 3538,
        "x_details": [
          {
            "input_tokens": 3259,
            "output_tokens": 279,
            "output_tokens_details": {
              "reasoning_tokens": 217
            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
            },
            "total_tokens": 3538,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U11",
      "role": "client",
      "text": "其实吧，我有时候真恨自己怎么连确认自己还活着都要靠摸手腕。这周在办公室听见隔壁两个年轻老师约着周末看电影，我差一点就凑过去说“加我一个”，可话到嘴边又咽了回去，觉得自己跟她们已经不在一个世界里了。",
      "request_sha256": "dc5e04bc98b9cbb85cbb1a6caf822eb79e593c7b3dbebee0dc99d92aefa009c9",
      "usage": {
        "input_tokens": 3947,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 444,
        "output_tokens_details": {
          "reasoning_tokens": 382
        },
        "total_tokens": 4391,
        "x_details": [
          {
            "input_tokens": 3947,
            "output_tokens": 444,
            "output_tokens_details": {
              "reasoning_tokens": 382
            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
            },
            "total_tokens": 4391,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U12",
      "role": "counselor",
      "text": "你恨的不是摸手腕这个动作本身，而是自己已经累到需要用这种方式才能确认“还在”。看着隔壁老师约看电影，你差点凑过去又咽回去，那种“已经不在一个世界”的感觉，听起来很孤独。\n\n也许不是你真的不想靠近，而是你太久没允许自己踏进那种轻松里了。今天先到这里也可以，你已经把很多压着的东西说出来了。",
      "request_sha256": "8d5318668915328404e6f48605cdabbbc11f7b5815492d41d2b32529ba005f3c",
      "usage": {
        "input_tokens": 3435,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 228,
        "output_tokens_details": {
          "reasoning_tokens": 146
        },
        "total_tokens": 3663,
        "x_details": [
          {
            "input_tokens": 3435,
            "output_tokens": 228,
            "output_tokens_details": {
              "reasoning_tokens": 146
            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
            },
            "total_tokens": 3663,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S03-U13",
      "role": "client",
      "text": "其实吧，我有时候听她们聊周末、聊新开的店，心里会忍不住想，要是我也还没结婚、没孩子，现在是不是也能这么轻松。可这话我不敢跟任何人说，连自己想一想都觉得不配。",
      "request_sha256": "3020c82ac0dc8ceb1fb2eec9602ac645cfa43e7bd341bbd2f7f1d42726985219",
      "usage": {
        "input_tokens": 4139,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 256,
        "output_tokens_details": {
          "reasoning_tokens": 207
        },
        "total_tokens": 4395,
        "x_details": [
          {
            "input_tokens": 4139,
            "output_tokens": 256,
            "output_tokens_details": {
              "reasoning_tokens": 207
            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
