        ]
      }
    },
    {
      "id": "P06-S03-U09",
      "role": "client",
      "text": "其实吧，我有时候半夜醒过来，得先摸一摸自己的手腕才敢动。那晚在厨房地上，药瓶是凉的，可我一直出汗，衣服贴在背上，又觉得自己像被人从头顶撕开了。",
      "request_sha256": "aa4c85eb7237e9771f7f1c1ced2bf0b54a045456347461d2070fa8d553efc644",
      "usage": {
        "input_tokens": 3784,
        "input_tokens_details": {
          "cached_tokens": 2048
        },
        "output_tokens": 399,
        "output_tokens_details": {
          "reasoning_tokens": 350
        },
        "total_tokens": 4183,
        "x_details": [
          {
            "input_tokens": 3784,
            "output_tokens": 399,
            "output_tokens_details": {
              "reasoning_tokens": 350
            },
            "prompt_tokens_details": {
              "cached_tokens": 2048
