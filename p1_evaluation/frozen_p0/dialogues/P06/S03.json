        },
        "output_tokens": 183,
        "output_tokens_details": {
          "reasoning_tokens": 143
        },
        "total_tokens": 3797,
        "x_details": [
          {
            "input_tokens": 3614,
            "output_tokens": 183,
            "output_tokens_details": {
