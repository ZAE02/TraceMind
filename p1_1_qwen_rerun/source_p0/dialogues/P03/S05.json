        },
        "output_tokens": 698,
        "output_tokens_details": {
          "reasoning_tokens": 626
        },
        "total_tokens": 7261,
        "x_details": [
          {
            "input_tokens": 6563,
            "output_tokens": 698,
            "output_tokens_details": {
              "reasoning_tokens": 626
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 7261,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P03-S05-U13",
      "role": "client",
      "text": "其实……我刚刚听到“不急着把话补完”，又有点慌，好像每次停下来我都会担心自己是不是又在逃。不过今天说到“越想要越觉得自己没有”，我反而觉得稍微能喘口气。可能我回去还是不会点那个音频，但至少现在不那么想逼自己了。",
      "request_sha256": "ee83601dde2dd9813674f7e77aed40c5d52bc03e832a4dac634cd321ba4ac9d4",
      "usage": {
        "input_tokens": 7469,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 522,
        "output_tokens_details": {
          "reasoning_tokens": 458
        },
        "total_tokens": 7991,
        "x_details": [
