            "prompt_tokens_details": {
              "cached_tokens": 5120
            },
            "total_tokens": 7672,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P03-S05-U08",
      "role": "counselor",
      "text": "手指停在播放键上的那一下，好像是你既想从自己的声音里听到一个确定答案，又怕那个答案一旦出来，你就更不知道该怎么站住。你从别人那里对答案，却越对越晃，也许是因为那些反应都在替你说“你很紧张”，而不是帮你稳住“你其实也在努力撑过去”。",
      "request_sha256": "5a4639187d5c87cd5d61088734b434050535a4f08fba3ece2c0ff82cd7081d0b",
      "usage": {
        "input_tokens": 6201,
        "input_tokens_details": {
          "cached_tokens": 5120
        },
        "output_tokens": 381,
        "output_tokens_details": {
          "reasoning_tokens": 310
        },
        "total_tokens": 6582,
        "x_details": [
