            "total_tokens": 2812,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S02-U10",
      "role": "counselor",
      "text": "听起来你并不是没有方向，而是每条路都牵着你不想拖累的人——父亲的身体、和周宁之间没摊开的话，所以晚上才会被那几张聊天记录堵住。她不再追问，好像也没有让你松下来，反而让这些事更只能由你一个人消化。",
      "request_sha256": "cdc61bb5be63bf59de099f01e23b343b75638f54c5bd49c238416a8d5be4b87b",
      "usage": {
        "input_tokens": 1896,
