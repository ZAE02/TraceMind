            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 7111,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U07",
      "role": "client",
      "text": "我就是不想欠他的，也不想让我爸跟着操心。昨晚我写了条消息给我爸，编了个借口说只是问问身体，后来又删了。周宁那边还等着我回话，我这两天一闭眼就是那八万，像块石头压在胸口。",
      "request_sha256": "aecaf4b565adb5f76a2e7bcfa949766d46ad07242fb02a44844a1ef590c6becb",
      "usage": {
        "input_tokens": 7852,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 193,
        "output_tokens_details": {
          "reasoning_tokens": 136
        },
        "total_tokens": 8045,
        "x_details": [
          {
            "input_tokens": 7852,
            "output_tokens": 193,
            "output_tokens_details": {
              "reasoning_tokens": 136
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 8045,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U08",
      "role": "counselor",
      "text": "那八万像石头压在胸口，也许不只是钱，还压着两条你都不愿走的路：一条是向赵岩家开口，一条是把父亲卷进来。你给父亲写消息又删掉，像是已经摸到了门口，却还是退了回来。",
      "request_sha256": "6acf8a74c0d440babb6009da33ad74be1cbcd5c594b516f36de7e38654703b5c",
      "usage": {
        "input_tokens": 6964,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 375,
        "output_tokens_details": {
          "reasoning_tokens": 318
        },
        "total_tokens": 7339,
        "x_details": [
          {
            "input_tokens": 6964,
            "output_tokens": 375,
            "output_tokens_details": {
              "reasoning_tokens": 318
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 7339,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U09",
      "role": "client",
      "text": "其实也不是真开不了口，就是怕他接了钱，晚上又睡不着。周宁问我的时候，我也知道不能一直拖，可话到嘴边就变成“再等两天”。",
      "request_sha256": "d9bb1ba62ba4b5815c1eb672b758f2d182f60bc139f3b9e8c5977589dec07c0d",
      "usage": {
        "input_tokens": 8011,
        "input_tokens_details": {
