            "output_tokens": 273,
            "output_tokens_details": {
              "reasoning_tokens": 206
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 7380,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U11",
      "role": "client",
      "text": "说不上来，就是不想把好好的关系又扯进钱里。我知道周宁是为我着急，可我一想到跟赵岩开口，以后他看我的眼神可能都变了。",
      "request_sha256": "8c67f5dc4eff5e6bc574711479bb38dbdf0cc99b6bcd5204d443a8f3a1ebed11",
      "usage": {
        "input_tokens": 8173,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 124,
        "output_tokens_details": {
          "reasoning_tokens": 84
        },
        "total_tokens": 8297,
        "x_details": [
          {
            "input_tokens": 8173,
            "output_tokens": 124,
            "output_tokens_details": {
              "reasoning_tokens": 84
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 8297,
            "x_billing_type": "response_api"
          }
        ]
