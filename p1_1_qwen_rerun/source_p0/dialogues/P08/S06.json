            "output_tokens_details": {
              "reasoning_tokens": 816
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 8241,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U02",
      "role": "counselor",
      "text": "你主动请赵岩吃饭、道歉，像是把那段一直别着的关系松了松；但他说你“不把他当贼防了”时，你心里又涌上一点说不上来的别扭。周宁提议借那八万时你没接，是不是“借”这个字一下又碰到了你一直很介意的那个“欠”？",
      "request_sha256": "c4344d170895d62b413f02974c1f8692a12bf67339e5778e3c04688144a45b7b",
      "usage": {
        "input_tokens": 6481,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 130,
        "output_tokens_details": {
          "reasoning_tokens": 56
        },
        "total_tokens": 6611,
        "x_details": [
          {
            "input_tokens": 6481,
            "output_tokens": 130,
            "output_tokens_details": {
              "reasoning_tokens": 56
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 6611,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U03",
      "role": "client",
      "text": "我也不是不想把房子的事往前推，就是周宁一说借他家的，我心里那根弦又绷起来了。昨晚我都翻到我爸电话了，想打，又想他身体本来就不行，还是别让他跟着着急。",
      "request_sha256": "3d56f5c7967c0d727d11a1bdce7e16df53b2fa0c95c8fdb2f8c113cdd796e22e",
      "usage": {
        "input_tokens": 7545,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 191,
        "output_tokens_details": {
          "reasoning_tokens": 141
        },
        "total_tokens": 7736,
        "x_details": [
          {
            "input_tokens": 7545,
            "output_tokens": 191,
            "output_tokens_details": {
              "reasoning_tokens": 141
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 7736,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U04",
      "role": "counselor",
      "text": "周宁一提“借他家”，你心里那根弦又绷起来，好像和赵岩好不容易松下来的距离，又得被钱重新拉回某种你不想处在的位置。而你翻到父亲的电话又放下，不是没想过开口，更像是怕一拨出去，父亲的身体和你的着急就缠在一起了。",
      "request_sha256": "44b63bead35bbe54e2d4c5a3983413bc730e21bba1e6641a1dd7523ae7edf79e",
      "usage": {
        "input_tokens": 6650,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 274,
        "output_tokens_details": {
          "reasoning_tokens": 206
        },
        "total_tokens": 6924,
        "x_details": [
          {
            "input_tokens": 6650,
            "output_tokens": 274,
            "output_tokens_details": {
              "reasoning_tokens": 206
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 6924,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U05",
      "role": "client",
      "text": "我也不是没想过，就是他那身体，我电话都翻出来了，最后还是没拨。周宁那边我也知道她着急，可这钱要是真跟赵岩家张嘴，我以后在他面前还怎么抬头。",
      "request_sha256": "a7f1283937e4394a6eed5beb0e046d049fffae16565c769ed03bd67c69d460fd",
      "usage": {
        "input_tokens": 7708,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 299,
        "output_tokens_details": {
          "reasoning_tokens": 252
        },
        "total_tokens": 8007,
        "x_details": [
          {
