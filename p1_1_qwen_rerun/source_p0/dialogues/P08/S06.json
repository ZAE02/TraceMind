            "output_tokens": 299,
            "output_tokens_details": {
              "reasoning_tokens": 252
            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 8007,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P08-S06-U06",
      "role": "counselor",
      "text": "“抬头”这个词好像把你对关系的感受说得很重——借了钱，就像在自己和赵岩之间矮下一截。可你同时又不忍心把父亲卷进来，所以那八万就卡在两边都不敢动的位置上。",
      "request_sha256": "df78d8db93dc09a8bbebbd36f047d2a378e187a8e690bfc776b4572bf4ffaa98",
      "usage": {
        "input_tokens": 6810,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 301,
        "output_tokens_details": {
          "reasoning_tokens": 249
        },
        "total_tokens": 7111,
        "x_details": [
          {
            "input_tokens": 6810,
            "output_tokens": 301,
            "output_tokens_details": {
              "reasoning_tokens": 249
