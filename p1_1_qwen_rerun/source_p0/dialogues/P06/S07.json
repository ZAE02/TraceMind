            "total_tokens": 10321,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P06-S07-U08",
      "role": "counselor",
      "text": "你盯着那些细节，不是不信任他，更像是没办法从“只有我盯着才不会出错”的位置上下来。可你又会烦自己，觉得人家来搭手，自己却像在监工——这个“烦”里，好像也有一点点想允许自己不用再盯那么紧，却又不知道该怎么放手。",
      "request_sha256": "1bd7aeffed6ded26de8fcb17bbc003dcbf4660934f6e26eb19ccb75f78deec28",
      "usage": {
        "input_tokens": 8599,
