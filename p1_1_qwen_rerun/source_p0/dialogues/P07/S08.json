            },
            "prompt_tokens_details": {
              "cached_tokens": 10240
            },
            "total_tokens": 12270,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U10",
      "role": "counselor",
      "text": "你发现不打草稿也能发出消息，虽然心跳快，但那种“说错台词”的羞耻感没那么重了——好像你开始允许自己在关系里不那么熟练地存在。周姐那边先不看，也许也是因为你不想让一个“派急活”的消息，太快打断你刚有的一点不表演的尝试。",
      "request_sha256": "6847ff6bcbc0f1ab0586ff16bc48ffd65ba6d226d8d79eff8e410ffe980c49a0",
      "usage": {
        "input_tokens": 10939,
        "input_tokens_details": {
          "cached_tokens": 10240
        },
        "output_tokens": 195,
        "output_tokens_details": {
          "reasoning_tokens": 124
        },
        "total_tokens": 11134,
        "x_details": [
          {
