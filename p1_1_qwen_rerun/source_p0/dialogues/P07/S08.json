        "total_tokens": 11325,
        "x_details": [
          {
            "input_tokens": 11129,
            "output_tokens": 196,
            "output_tokens_details": {
              "reasoning_tokens": 146
            },
            "prompt_tokens_details": {
              "cached_tokens": 10240
            },
            "total_tokens": 11325,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U13",
      "role": "client",
      "text": "“不熟练地存在”这句话，我今晚想带着走一段。好像以前总觉得跟人说话得有个完整剧本，现在至少敢让自己卡壳一次了。今天到这儿吧，我回去可能先喂糯糯，手机就让它继续倒扣在桌上。",
      "request_sha256": "1e8a29680a2a6b6466b595c67818f4e96f10c911da52ccd4f78634992fa65121",
      "usage": {
        "input_tokens": 12355,
        "input_tokens_details": {
          "cached_tokens": 10240
        },
        "output_tokens": 424,
        "output_tokens_details": {
          "reasoning_tokens": 366
        },
        "total_tokens": 12779,
        "x_details": [
          {
            "input_tokens": 12355,
            "output_tokens": 424,
            "output_tokens_details": {
              "reasoning_tokens": 366
            },
            "prompt_tokens_details": {
              "cached_tokens": 10240
            },
            "total_tokens": 12779,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U14",
      "role": "counselor",
      "text": "带着这句话走，也继续允许自己卡壳，不必立刻把“不熟练”变成新的完美要求。喂糯糯时，手机倒扣着就好，我们下次再慢慢说。",
      "request_sha256": "b5481029a26a2de86b67eaae6b65b16a9d67dd7c1eddb932fa042f96229414bc",
      "usage": {
        "input_tokens": 11282,
        "input_tokens_details": {
