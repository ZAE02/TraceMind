            "total_tokens": 11916,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U02",
      "role": "counselor",
      "text": "你刚说的“也许不是怕见人，是以前把见人都当成一场必须演好的戏”，听起来不只是一个标签的松动，更像你开始看见自己累的真正来源。私信点开又退出来，可能不是不想回应，而是怕一回应，那种“原来有人也这样”的轻松感就被重新拉回“要演好”的压力里。",
      "request_sha256": "c4adfe184f9f1291b54b69afc9cc866ba9738f2ed38783498968d4cd80f284cb",
      "usage": {
        "input_tokens": 10179,
        "input_tokens_details": {
          "cached_tokens": 0
        },
        "output_tokens": 282,
        "output_tokens_details": {
          "reasoning_tokens": 203
        },
        "total_tokens": 10461,
        "x_details": [
          {
            "input_tokens": 10179,
            "output_tokens": 282,
            "output_tokens_details": {
              "reasoning_tokens": 203
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 10461,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U03",
      "role": "client",
      "text": "其实这两天我一直在回味你刚才说的那种“怕把共鸣搞砸”的感觉，好像那条私信本身不是重点，重点是我终于不用在聊天框里先给自己搭个台子。以前每次回复别人，都像上台前检查妆有没有花，一句话没接好就觉得整段都演砸了。现在想想，那种“社恐”可能只是我不想再上台。",
      "request_sha256": "de0548289fcee4bc44161819ce7bddebdc82ee50a5020943fb14a19cad0ba6dd",
      "usage": {
        "input_tokens": 11434,
        "input_tokens_details": {
          "cached_tokens": 9216
        },
        "output_tokens": 503,
        "output_tokens_details": {
          "reasoning_tokens": 421
        },
        "total_tokens": 11937,
        "x_details": [
          {
            "input_tokens": 11434,
            "output_tokens": 503,
            "output_tokens_details": {
              "reasoning_tokens": 421
            },
            "prompt_tokens_details": {
              "cached_tokens": 9216
            },
            "total_tokens": 11937,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U04",
      "role": "counselor",
      "text": "把见人当成必须演好的戏，把回复当成上台前检查妆有没有花——这个比喻好像让你从“怕人”里松动了一点，更看清自己真正累的是那个“必须演好”的部分。那条私信也许让你碰到一种可以不搭台子的接触，所以你既想靠近，又怕一开口又把自己推回台上。",
      "request_sha256": "814c0de05a26be8e53d83a782b0a1a42006d142f8d28dd36078a88092eb0364b",
      "usage": {
        "input_tokens": 10385,
        "input_tokens_details": {
          "cached_tokens": 9216
        },
        "output_tokens": 652,
        "output_tokens_details": {
          "reasoning_tokens": 577
        },
        "total_tokens": 11037,
        "x_details": [
          {
            "input_tokens": 10385,
            "output_tokens": 652,
            "output_tokens_details": {
              "reasoning_tokens": 577
            },
            "prompt_tokens_details": {
              "cached_tokens": 9216
            },
            "total_tokens": 11037,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U05",
      "role": "client",
      "text": "其实那条私信我到现在都没回，不是摆架子，是每次想打几个字，脑子里就开始自动排演对方下一句会怎么接，像突然被拉回以前那种社交考试里。可我又觉得，要是这次还躲过去，那分享会上好不容易塌下来的那道墙，可能又得自己砌回去。",
      "request_sha256": "a21db066d379bf013f172f0a321772023baac48a8a71c4873e4f2af20d648d9d",
      "usage": {
        "input_tokens": 11636,
        "input_tokens_details": {
          "cached_tokens": 11264
        },
        "output_tokens": 128,
        "output_tokens_details": {
          "reasoning_tokens": 58
        },
        "total_tokens": 11764,
        "x_details": [
          {
            "input_tokens": 11636,
            "output_tokens": 128,
            "output_tokens_details": {
              "reasoning_tokens": 58
            },
            "prompt_tokens_details": {
              "cached_tokens": 11264
            },
            "total_tokens": 11764,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S08-U06",
      "role": "counselor",
      "text": "你正在经历两个动作的拉扯：一开口就像被推回那场社交考试，可不开口又怕刚塌下来的墙又要自己砌回去。也许你可以不用马上决定回或不回，而是先看看这个拉扯本身——它说明你已经不完全站在旧的那一边了。",
      "request_sha256": "98d02d3d042f345facaa0d5acc238497134ab42505832ca5087c989cc61eb2a0",
      "usage": {
        "input_tokens": 10575,
        "input_tokens_details": {
          "cached_tokens": 10240
        },
        "output_tokens": 239,
        "output_tokens_details": {
          "reasoning_tokens": 180
