            "total_tokens": 989,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P07-S01-U09",
      "role": "client",
      "text": "其实今天最后能出门，可能也不是因为猫，是因为预约取消还要打一次电话，我连那个电话也不想打。糯糯钻包里的样子确实有点好笑，像在替我做决定。关机这个说法挺准的，我怕的不是黑下去，是怕哪天躺够了想开机，结果屏幕怎么按都不亮。",
      "request_sha256": "314b57d4e62f934e876f1475df234659b8e1d82aec5cacb319f773629719062c",
      "usage": {
        "input_tokens": 1317,
        "input_tokens_details": {
          "cached_tokens": 0
