    {
      "id": "P05-S05-U12",
      "role": "counselor",
      "text": "你习惯先替别人把门关上，可关上之后，那扇门里的“老想起来”却一直没有真正停下来。今天先到这里吧，我们可以把这个“躲和盼之间反复”的感觉先放一放，不用现在把它说清。",
      "request_sha256": "2f9b8c2c63e24f2061e517d558e3d106332e0ca2975cccf3e03eb5119d211666",
      "usage": {
        "input_tokens": 6212,
        "input_tokens_details": {
          "cached_tokens": 5120
        },
        "output_tokens": 204,
        "output_tokens_details": {
          "reasoning_tokens": 151
        },
        "total_tokens": 6416,
        "x_details": [
          {
            "input_tokens": 6212,
            "output_tokens": 204,
            "output_tokens_details": {
              "reasoning_tokens": 151
            },
            "prompt_tokens_details": {
              "cached_tokens": 5120
            },
            "total_tokens": 6416,
            "x_billing_type": "response_api"
          }
