            "prompt_tokens_details": {
              "cached_tokens": 5120
            },
            "total_tokens": 5975,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P05-S05-U05",
      "role": "client",
      "text": "其实这周我哭过一次，在厕所里，出来之后删了一条写到一半的动态。那会儿我觉得自己特别矫情，又有点后悔删了。我躲李繁，可能是不想让她看见我这样。",
      "request_sha256": "82a38c6f6cc0f909fbdd2bce6ea9119ebe268b0db64a47b076949422904fd124",
      "usage": {
        "input_tokens": 6302,
        "input_tokens_details": {
          "cached_tokens": 5120
        },
        "output_tokens": 719,
        "output_tokens_details": {
          "reasoning_tokens": 672
        },
        "total_tokens": 7021,
        "x_details": [
          {
            "input_tokens": 6302,
            "output_tokens": 719,
            "output_tokens_details": {
              "reasoning_tokens": 672
