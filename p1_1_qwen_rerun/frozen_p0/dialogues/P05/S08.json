            },
            "total_tokens": 9682,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P05-S08-U03",
      "role": "client",
      "text": "“也不是什么值不值得吧，我就怕真到了半路坐地上起不来，那才丢人。其实我还偷偷查过路线，看到旁边有补给点，但看两眼就退了。整理外卖盒的时候，突然觉得家里空一点，人也能喘口气，不过马上又觉得这事太可笑了。”",
      "request_sha256": "b80dd81ed712de712a0a4857bf7af51ddf356d75f32ecb3db300d593d6bb5a30",
      "usage": {
        "input_tokens": 10545,
        "input_tokens_details": {
          "cached_tokens": 9216
        },
        "output_tokens": 431,
        "output_tokens_details": {
          "reasoning_tokens": 363
        },
        "total_tokens": 10976,
        "x_details": [
          {
            "input_tokens": 10545,
