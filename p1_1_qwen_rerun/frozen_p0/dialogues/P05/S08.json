            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P05-S08-U04",
      "role": "counselor",
      "text": "你查路线看到补给点，看两眼就退出来，好像多停留一会儿，那个“想去”就会变得更真实、也更难再收回去了。整理外卖盒后家里空一点、能喘口气，这本是你给自己的照顾，可你又很快用“可笑”把它压下去——那种短暂的轻松，似乎总让你不敢认领。",
      "request_sha256": "82bb075da89eed1c3903b851c1bfa71c29b4d4bb3e6d65427bd214ca095fba42",
      "usage": {
        "input_tokens": 9698,
        "input_tokens_details": {
          "cached_tokens": 9216
        },
        "output_tokens": 494,
        "output_tokens_details": {
