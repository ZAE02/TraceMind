            },
            "prompt_tokens_details": {
              "cached_tokens": 6144
            },
            "total_tokens": 7106,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P05-S06-U05",
      "role": "client",
      "text": "其实我到现在都没把照片发出去，怕发出去她就知道我在意了。可要是她以后不寄了，我可能又觉得空。我老觉得自己在等一个别人先靠近的理由，近了又反射性地推开。",
      "request_sha256": "e0196a331c94572e17dde2cbcd31856a8210797978240ca9418ecf5874e1ceec",
      "usage": {
        "input_tokens": 7646,
        "input_tokens_details": {
          "cached_tokens": 6144
        },
        "output_tokens": 370,
        "output_tokens_details": {
          "reasoning_tokens": 320
        },
        "total_tokens": 8016,
        "x_details": [
          {
            "input_tokens": 7646,
            "output_tokens": 370,
            "output_tokens_details": {
              "reasoning_tokens": 320
