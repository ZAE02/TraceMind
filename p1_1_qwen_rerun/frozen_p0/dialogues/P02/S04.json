            "output_tokens": 674,
            "output_tokens_details": {
              "reasoning_tokens": 609
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 5139,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S04-U02",
      "role": "counselor",
      "text": "听起来，那个“习惯就好”像是替你压住了心里很多说不清的堵，可身体却还是没法真正放松下来——手机一响就坐起来，好像一直在等下一个电话来打断你。这一天里，休息和时间都不像是自己的，连补觉都只能“刚迷糊就醒”。",
      "request_sha256": "77f2e926d663bd92ae6b95a86e2227c246240b821a11d0b827943b1802c0c6f8",
      "usage": {
        "input_tokens": 3988,
        "input_tokens_details": {
          "cached_tokens": 0
        },
        "output_tokens": 181,
        "output_tokens_details": {
          "reasoning_tokens": 118
        },
        "total_tokens": 4169,
        "x_details": [
          {
            "input_tokens": 3988,
            "output_tokens": 181,
            "output_tokens_details": {
              "reasoning_tokens": 118
            },
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "total_tokens": 4169,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S04-U03",
      "role": "client",
      "text": "其实培训的时候我差点睡着，被旁边同事拍了一下，挺丢人的。下午回家想补觉，又一直竖着耳朵听手机，越躺越清醒，干脆起来把菜切了。我妈问怎么不睡，我说不困，其实太阳穴一直跳。",
      "request_sha256": "ac733242509b65ce124ea7e4a52510c63a1fbadb382c1de34443fcc2d3d60d41",
      "usage": {
        "input_tokens": 4639,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 743,
        "output_tokens_details": {
          "reasoning_tokens": 683
        },
        "total_tokens": 5382,
        "x_details": [
          {
            "input_tokens": 4639,
            "output_tokens": 743,
            "output_tokens_details": {
              "reasoning_tokens": 683
            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
            },
            "total_tokens": 5382,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S04-U04",
      "role": "counselor",
      "text": "你嘴上说“不困”，可太阳穴一直在跳，像是身体在替你说那个还没被承认的累。补觉时竖着耳朵听手机，人躺着，警觉却没躺下；起来切菜，好像反而成了不用解释、又能让你暂时不面对“睡不着”的办法。",
      "request_sha256": "37fd16b69c0681ce1bf048d5abda98499464fc47d457bfee04d855b0729b2727",
      "usage": {
        "input_tokens": 4156,
        "input_tokens_details": {
          "cached_tokens": 3072
        },
        "output_tokens": 288,
        "output_tokens_details": {
          "reasoning_tokens": 225
        },
        "total_tokens": 4444,
        "x_details": [
          {
            "input_tokens": 4156,
            "output_tokens": 288,
            "output_tokens_details": {
              "reasoning_tokens": 225
            },
            "prompt_tokens_details": {
              "cached_tokens": 3072
            },
            "total_tokens": 4444,
            "x_billing_type": "response_api"
          }
        ]
      }
    },
    {
      "id": "P02-S04-U05",
      "role": "client",
      "text": "其实切菜的时候手也有点抖，有一下差点切到指甲，我就停下来扶着台面站了一会儿。我妈在客厅喊我别太累，我回了句“知道”，声音轻得自己都听不清。",
      "request_sha256": "aa2db9a966580b03dfd5c194ddb03bc4d91934b2f8d22f01d67af1032570faba",
      "usage": {
        "input_tokens": 4807,
        "input_tokens_details": {
