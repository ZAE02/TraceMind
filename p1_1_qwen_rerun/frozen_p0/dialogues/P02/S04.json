  "utterances": [
    {
      "id": "P02-S04-U01",
      "role": "client",
      "text": "其实我昨天好不容易排到一天休，上午一个电话又把我叫回中心培训了。下午回家想补个觉，结果每回刚迷糊就醒，手机一响我整个人就坐起来。晚上照常给我妈热敷，我嘴上说习惯就好，心里其实堵得慌。",
      "request_sha256": "3c982a817245057919c9d87c095716214821d299ae361e7a5fe2be66c1919dfd",
      "usage": {
        "input_tokens": 4465,
        "input_tokens_details": {
          "cached_tokens": 0
        },
        "output_tokens": 674,
        "output_tokens_details": {
          "reasoning_tokens": 609
        },
        "total_tokens": 5139,
        "x_details": [
          {
